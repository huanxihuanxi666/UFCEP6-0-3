          "value": "ACCEPT"
        },
        {
          "label": "Reject",
          "value": "REJECT"
        },
        {
          "label": "Request further information",
          "value": "MORE_INFORMATION"
        },
        {
          "label": "Redirect",
          "value": "REDIRECT"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
