<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Defs_Referral" targetNamespace="http://hospital.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:collaboration id="Collab_Referral">
    <bpmn:participant id="P_Hospital" name="Hospital Patient Administration System" processRef="Process_Referral" />
    <bpmn:participant id="P_Referrer" name="Referring Organisation" />
    <bpmn:messageFlow id="M_Referral" name="Referral" sourceRef="P_Referrer" targetRef="S_Referral" />
    <bpmn:messageFlow id="M_MissingReq" name="Missing Information Request" sourceRef="T_RequestMissing" targetRef="P_Referrer" />
    <bpmn:messageFlow id="M_MissingInfo" name="Additional Information" sourceRef="P_Referrer" targetRef="T_ReceiveMissing" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Referral" name="Referral &#38; Consultant Review" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Referral">
      <bpmn:lane id="L_Secretary" name="Medical Secretary">
        <bpmn:flowNodeRef>T_RecordReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CheckReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_InfoComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Referral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReceiveMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ValidateReferral</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Consultant" name="Consultant / Clinical Team">
        <bpmn:flowNodeRef>T_RejectReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ReferralDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestMoreClinical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AcceptReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RedirectReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Redirected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ConsultReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ValidateReferral</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="T_RecordReferral" name="Record Referral &#38; Supporting Documents">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_ReferralIntake" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_001</bpmn:incoming>
      <bpmn:outgoing>Flow_002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_CheckReferral" name="Check Supporting Information">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReferralValidated</bpmn:incoming>
      <bpmn:incoming>Flow_006</bpmn:incoming>
      <bpmn:outgoing>Flow_003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_InfoComplete" name="Supporting Information Complete?">
      <bpmn:incoming>Flow_003</bpmn:incoming>
      <bpmn:outgoing>Flow_004</bpmn:outgoing>
      <bpmn:outgoing>Flow_007</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_RejectReferral" name="Record Rejection Reason">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_011</bpmn:incoming>
      <bpmn:outgoing>Flow_012</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_Rejected" name="Referral Rejected">
      <bpmn:incoming>Flow_012</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_RequestMissing" name="Request Missing Information">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_004</bpmn:incoming>
      <bpmn:outgoing>Flow_005</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="S_Referral" name="Referral Received">
      <bpmn:outgoing>Flow_001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G_ReferralDecision" name="Referral Decision">
      <bpmn:incoming>Flow_008</bpmn:incoming>
      <bpmn:outgoing>Flow_011</bpmn:outgoing>
      <bpmn:outgoing>Flow_015</bpmn:outgoing>
      <bpmn:outgoing>Flow_1u1ekb2</bpmn:outgoing>
      <bpmn:outgoing>Flow_013</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ReceiveMissing" name="Receive Missing Information">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_ReferralIntake" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_016</bpmn:incoming>
      <bpmn:incoming>Flow_005</bpmn:incoming>
      <bpmn:outgoing>Flow_006</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_RequestMoreClinical" name="Request Further Clinical Information">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_015</bpmn:incoming>
      <bpmn:outgoing>Flow_016</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_AcceptReferral" name="Record Acceptance + Booking Requirements">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1u1ekb2</bpmn:incoming>
      <bpmn:outgoing>Flow_010</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_Accepted" name="Accepted Referral Handover">
      <bpmn:incoming>Flow_010</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_RedirectReferral" name="Record Redirect &#38; Target Service">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_013</bpmn:incoming>
      <bpmn:outgoing>Flow_014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_Redirected" name="Referral Redirected">
      <bpmn:incoming>Flow_014</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_ConsultReview" name="Perform Consultant Review">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_ConsultantReview" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_007</bpmn:incoming>
      <bpmn:outgoing>Flow_008</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_001" sourceRef="S_Referral" targetRef="T_RecordReferral" />
    <bpmn:sequenceFlow id="Flow_002" sourceRef="T_RecordReferral" targetRef="T_ValidateReferral" />
    <bpmn:sequenceFlow id="Flow_ReferralValidated" sourceRef="T_ValidateReferral" targetRef="T_CheckReferral" />
    <bpmn:sequenceFlow id="Flow_006" sourceRef="T_ReceiveMissing" targetRef="T_CheckReferral" />
    <bpmn:sequenceFlow id="Flow_003" sourceRef="T_CheckReferral" targetRef="G_InfoComplete" />
    <bpmn:sequenceFlow id="Flow_004" name="No" sourceRef="G_InfoComplete" targetRef="T_RequestMissing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(get or else(informationComplete, false))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_007" name="Yes" sourceRef="G_InfoComplete" targetRef="T_ConsultReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(informationComplete, false)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_011" name="Reject" sourceRef="G_ReferralDecision" targetRef="T_RejectReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(referralDecision, "") = "REJECT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_012" sourceRef="T_RejectReferral" targetRef="E_Rejected" />
    <bpmn:sequenceFlow id="Flow_005" sourceRef="T_RequestMissing" targetRef="T_ReceiveMissing" />
    <bpmn:sequenceFlow id="Flow_008" sourceRef="T_ConsultReview" targetRef="G_ReferralDecision" />
    <bpmn:sequenceFlow id="Flow_015" name="More information" sourceRef="G_ReferralDecision" targetRef="T_RequestMoreClinical">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(referralDecision, "") = "MORE_INFORMATION"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1u1ekb2" name="Accept" sourceRef="G_ReferralDecision" targetRef="T_AcceptReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(referralDecision, "") = "ACCEPT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_013" name="Redirect" sourceRef="G_ReferralDecision" targetRef="T_RedirectReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(referralDecision, "") = "REDIRECT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_016" sourceRef="T_RequestMoreClinical" targetRef="T_ReceiveMissing" />
    <bpmn:sequenceFlow id="Flow_010" sourceRef="T_AcceptReferral" targetRef="E_Accepted" />
    <bpmn:sequenceFlow id="Flow_014" sourceRef="T_RedirectReferral" targetRef="E_Redirected" />
    <bpmn:serviceTask id="T_ValidateReferral" name="Validate Referral Reference with External Intake Service">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-referral-reference" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_002</bpmn:incoming>
      <bpmn:outgoing>Flow_ReferralValidated</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Referral">
    <bpmndi:BPMNPlane id="Plane_Referral" bpmnElement="Collab_Referral">
      <bpmndi:BPMNShape id="Shape_P_Hospital" bpmnElement="P_Hospital" isHorizontal="true">
        <dc:Bounds x="160" y="310" width="1730" height="530" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_Consultant" bpmnElement="L_Consultant" isHorizontal="true">
        <dc:Bounds x="190" y="480" width="1700" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_Secretary" bpmnElement="L_Secretary" isHorizontal="true">
        <dc:Bounds x="190" y="310" width="1700" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_RecordReferral" bpmnElement="T_RecordReferral">
        <dc:Bounds x="380" y="365" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_CheckReferral" bpmnElement="T_CheckReferral">
        <dc:Bounds x="590" y="365" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_InfoComplete" bpmnElement="G_InfoComplete" isMarkerVisible="true">
