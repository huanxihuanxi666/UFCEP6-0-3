<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Defs_Treatment" targetNamespace="http://hospital.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:collaboration id="Collab_Treatment">
    <bpmn:participant id="P_Hospital" name="Hospital Patient Administration System" processRef="Process_Treatment" />
    <bpmn:participant id="P_ClinicalServices" name="External Treatment / Laboratory / Imaging Services" />
    <bpmn:messageFlow id="M_Resource" name="Resource Availability Request" sourceRef="T_CheckResources" targetRef="P_ClinicalServices" />
    <bpmn:messageFlow id="M_Resource_Response" name="Resource Availability Response" sourceRef="P_ClinicalServices" targetRef="T_CheckResources" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Treatment" name="Treatment &#38; Chemotherapy" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Treatment">
      <bpmn:lane id="L_FinanceSupport" name="Finance Handover / Clearance">
        <bpmn:flowNodeRef>T_FundingClear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_FinImpact</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Treatment" name="Treatment &#38; Chemotherapy Bookings Team">
        <bpmn:flowNodeRef>G_Authorised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_BookTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Cycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_MoreCycles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TreatmentRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CheckResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_LetterHandover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RetryResource</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReturnUnauth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Resource</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Clinical" name="Consultant / Clinical Team">
        <bpmn:flowNodeRef>S_Attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Assessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Consent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_NoTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Modify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_BloodReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Consent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Clinical</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_Attend" name="Patient Attends Appointment">
      <bpmn:outgoing>Flow_001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G_Authorised" name="Request Complete &#38; Authorised?">
      <bpmn:incoming>Flow_006</bpmn:incoming>
      <bpmn:outgoing>Flow_007</bpmn:outgoing>
      <bpmn:outgoing>Flow_008</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_BookTreatment" name="Arrange / Confirm Treatment Appointment">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_011</bpmn:incoming>
      <bpmn:incoming>Flow_015</bpmn:incoming>
      <bpmn:outgoing>Flow_016</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Cycle" name="Deliver Treatment / Chemotherapy Cycle">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_TreatmentCycleReview" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_016</bpmn:incoming>
      <bpmn:incoming>Flow_021</bpmn:incoming>
      <bpmn:outgoing>Flow_017</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_MoreCycles" name="More Treatment Cycles Required?">
      <bpmn:incoming>Flow_017</bpmn:incoming>
      <bpmn:outgoing>Flow_018</bpmn:outgoing>
      <bpmn:outgoing>Flow_019</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Assessment" name="Assess Patient / Diagnosis / Treatment Options">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_ClinicalAssessment" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_001</bpmn:incoming>
      <bpmn:outgoing>Flow_002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Consent" name="Record Patient Consent">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_003</bpmn:incoming>
      <bpmn:outgoing>Flow_005</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_NoTreatment" name="No Treatment / Clinical Review">
      <bpmn:incoming>Flow_004</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_001" sourceRef="S_Attend" targetRef="T_Assessment" />
    <bpmn:sequenceFlow id="Flow_002" sourceRef="T_Assessment" targetRef="G_Consent" />
    <bpmn:sequenceFlow id="Flow_003" name="Yes" sourceRef="G_Consent" targetRef="T_Consent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(patientConsent, false)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_004" name="No" sourceRef="G_Consent" targetRef="E_NoTreatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(get or else(patientConsent, false))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_006" sourceRef="T_TreatmentRequest" targetRef="G_Authorised" />
    <bpmn:sequenceFlow id="Flow_007" name="Yes" sourceRef="G_Authorised" targetRef="T_CheckResources">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(treatmentAuthorised, false)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_008" name="No" sourceRef="G_Authorised" targetRef="T_ReturnUnauth">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(get or else(treatmentAuthorised, false))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_009" sourceRef="T_ReturnUnauth" targetRef="T_TreatmentRequest" />
    <bpmn:sequenceFlow id="Flow_014" sourceRef="T_RetryResource" targetRef="T_CheckResources" />
    <bpmn:sequenceFlow id="Flow_010" sourceRef="T_CheckResources" targetRef="G_Resource" />
    <bpmn:sequenceFlow id="Flow_011" name="Yes" sourceRef="G_Resource" targetRef="T_BookTreatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(treatmentAvailable, false)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_012" name="No" sourceRef="G_Resource" targetRef="T_Pending">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(get or else(treatmentAvailable, false))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_013" sourceRef="T_Pending" targetRef="T_RetryResource" />
    <bpmn:sequenceFlow id="Flow_015" sourceRef="T_FundingClear" targetRef="T_BookTreatment" />
    <bpmn:sequenceFlow id="Flow_016" sourceRef="T_BookTreatment" targetRef="T_Cycle" />
    <bpmn:sequenceFlow id="Flow_021" name="Continue" sourceRef="G_Clinical" targetRef="T_Cycle">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(clinicalDecision, "") = "CONTINUE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_017" sourceRef="T_Cycle" targetRef="G_MoreCycles" />
    <bpmn:sequenceFlow id="Flow_018" name="Yes" sourceRef="G_MoreCycles" targetRef="T_BloodReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(moreCycles, false)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_019" name="No" sourceRef="G_MoreCycles" targetRef="E_LetterHandover">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(get or else(moreCycles, false))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_023" sourceRef="T_Delay" targetRef="T_BloodReview" />
    <bpmn:sequenceFlow id="Flow_027" name="No" sourceRef="G_FinImpact" targetRef="T_BloodReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(get or else(financialImpact, false))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_020" sourceRef="T_BloodReview" targetRef="G_Clinical" />
    <bpmn:sequenceFlow id="Flow_022" name="Delay" sourceRef="G_Clinical" targetRef="T_Delay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(clinicalDecision, "") = "DELAY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_024" name="Modify" sourceRef="G_Clinical" targetRef="T_Modify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(clinicalDecision, "") = "MODIFY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_025" sourceRef="T_Modify" targetRef="G_FinImpact" />
    <bpmn:sequenceFlow id="Flow_005" sourceRef="T_Consent" targetRef="T_TreatmentRequest" />
    <bpmn:sequenceFlow id="Flow_026" name="Yes" sourceRef="G_FinImpact" targetRef="T_FundingClear">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(financialImpact, false)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="T_TreatmentRequest" name="Create Authorised Treatment Booking Request">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_TreatmentRequest" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_009</bpmn:incoming>
      <bpmn:incoming>Flow_005</bpmn:incoming>
      <bpmn:outgoing>Flow_006</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_CheckResources" name="Check Treatment / Lab / Imaging Availability">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-treatment-resource" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_007</bpmn:incoming>
      <bpmn:incoming>Flow_014</bpmn:incoming>
      <bpmn:outgoing>Flow_010</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Modify" name="Create Authorised Treatment Modification Request">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_TreatmentCycleReview" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_024</bpmn:incoming>
      <bpmn:outgoing>Flow_025</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Delay" name="Authorise Treatment Delay">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_022</bpmn:incoming>
      <bpmn:outgoing>Flow_023</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_BloodReview" name="Blood Test + Clinical Review">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_TreatmentCycleReview" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_018</bpmn:incoming>
      <bpmn:incoming>Flow_023</bpmn:incoming>
      <bpmn:incoming>Flow_027</bpmn:incoming>
      <bpmn:outgoing>Flow_020</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_LetterHandover" name="Treatment Complete / Clinic Letter Handover">
      <bpmn:incoming>Flow_019</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_RetryResource" name="Record Retry Attempt / Update Resource Availability">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_TreatmentRequest" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_013</bpmn:incoming>
      <bpmn:outgoing>Flow_014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_FundingClear" name="Refer Financial Impact to Finance / Confirm Updated Clearance">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_026</bpmn:incoming>
      <bpmn:outgoing>Flow_015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Consent" name="Patient Agrees to Treatment?">
      <bpmn:incoming>Flow_002</bpmn:incoming>
      <bpmn:outgoing>Flow_003</bpmn:outgoing>
      <bpmn:outgoing>Flow_004</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ReturnUnauth" name="Return / Reject Unauthorised Request">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_008</bpmn:incoming>
      <bpmn:outgoing>Flow_009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Pending" name="Keep Pending + Notify Team">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_012</bpmn:incoming>
      <bpmn:outgoing>Flow_013</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Resource" name="Resources Available?">
      <bpmn:incoming>Flow_010</bpmn:incoming>
      <bpmn:outgoing>Flow_011</bpmn:outgoing>
      <bpmn:outgoing>Flow_012</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_Clinical" name="Clinical Decision">
      <bpmn:incoming>Flow_020</bpmn:incoming>
      <bpmn:outgoing>Flow_021</bpmn:outgoing>
      <bpmn:outgoing>Flow_022</bpmn:outgoing>
      <bpmn:outgoing>Flow_024</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_FinImpact" name="Modification Has Financial Impact?">
      <bpmn:incoming>Flow_025</bpmn:incoming>
      <bpmn:outgoing>Flow_027</bpmn:outgoing>
      <bpmn:outgoing>Flow_026</bpmn:outgoing>
    </bpmn:exclusiveGateway>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Treatment">
    <bpmndi:BPMNPlane id="Plane_Treatment" bpmnElement="Collab_Treatment">
      <bpmndi:BPMNShape id="Shape_P_Hospital" bpmnElement="P_Hospital" isHorizontal="true">
        <dc:Bounds x="160" y="180" width="3100" height="780" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_Clinical" bpmnElement="L_Clinical" isHorizontal="true">
        <dc:Bounds x="190" y="180" width="3070" height="290" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_Treatment" bpmnElement="L_Treatment" isHorizontal="true">
        <dc:Bounds x="190" y="470" width="3070" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_FinanceSupport" bpmnElement="L_FinanceSupport" isHorizontal="true">
        <dc:Bounds x="190" y="750" width="3070" height="210" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_Attend" bpmnElement="S_Attend">
        <dc:Bounds x="230" y="355" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="211" y="391" width="75" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_Authorised" bpmnElement="G_Authorised" isMarkerVisible="true">
        <dc:Bounds x="1210" y="525" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1205" y="475" width="59" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_BookTreatment" bpmnElement="T_BookTreatment">
        <dc:Bounds x="2060" y="525" width="150" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_Cycle" bpmnElement="T_Cycle">
        <dc:Bounds x="2280" y="525" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_MoreCycles" bpmnElement="G_MoreCycles" isMarkerVisible="true">
        <dc:Bounds x="2510" y="525" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2491" y="487.5" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_Assessment" bpmnElement="T_Assessment">
        <dc:Bounds x="365" y="333" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_Consent" bpmnElement="T_Consent">
        <dc:Bounds x="1025" y="333" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_E_NoTreatment" bpmnElement="E_NoTreatment">
        <dc:Bounds x="812" y="400" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="792" y="436" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_TreatmentRequest" bpmnElement="T_TreatmentRequest">
        <dc:Bounds x="855" y="620" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_CheckResources" bpmnElement="T_CheckResources">
        <dc:Bounds x="1405" y="510" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_Modify" bpmnElement="T_Modify">
        <dc:Bounds x="3055" y="370" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_Delay" bpmnElement="T_Delay">
        <dc:Bounds x="2915" y="280" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_BloodReview" bpmnElement="T_BloodReview">
        <dc:Bounds x="2655" y="378" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_E_LetterHandover" bpmnElement="E_LetterHandover">
        <dc:Bounds x="2517" y="692" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2438" y="650" width="84" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_RetryResource" bpmnElement="T_RetryResource">
        <dc:Bounds x="1855" y="660" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_FundingClear" bpmnElement="T_FundingClear">
        <dc:Bounds x="1580" y="800" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_Consent" bpmnElement="G_Consent" isMarkerVisible="true">
        <dc:Bounds x="600" y="348" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="582" y="311" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_ReturnUnauth" bpmnElement="T_ReturnUnauth">
        <dc:Bounds x="1160" y="610" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_Pending" bpmnElement="T_Pending">
        <dc:Bounds x="1755" y="563" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_Resource" bpmnElement="G_Resource" isMarkerVisible="true">
        <dc:Bounds x="1630" y="572" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1603" y="618" width="53" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_Clinical" bpmnElement="G_Clinical" isMarkerVisible="true">
        <dc:Bounds x="2565" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2499" y="297" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_FinImpact" bpmnElement="G_FinImpact" isMarkerVisible="true">
        <dc:Bounds x="2745" y="825" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2727" y="885" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_001" bpmnElement="Flow_001">
        <di:waypoint x="266" y="373" />
        <di:waypoint x="365" y="373" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_002" bpmnElement="Flow_002">
        <di:waypoint x="515" y="373" />
        <di:waypoint x="600" y="373" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_003" bpmnElement="Flow_003">
        <di:waypoint x="643" y="366" />
        <di:waypoint x="1025" y="366" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="738" y="349" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_004" bpmnElement="Flow_004">
        <di:waypoint x="625" y="398" />
        <di:waypoint x="625" y="418" />
        <di:waypoint x="812" y="418" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="769" y="406" width="15" height="14" />
        </bpmndi:BPMNLabel>
