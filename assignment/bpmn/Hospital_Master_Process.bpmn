<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:ns1="http://camunda.org/schema/modeler/1.0" id="Definitions_Hospital_Master" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.8.0">
  <bpmn:process id="Process_Hospital_Master" name="Hospital Patient Pathway - Integrated Master" isExecutable="true">
    <bpmn:documentation>Integrated master process. Each Call Activity invokes one executable detailed BPMN. No duplicate master forms are used. Funding and payment clearance is completed before the treatment process is invoked, so a treatment appointment cannot be arranged before its financial route is clear. The Clinic Letter process follows every completed consultation path, including a decision not to proceed with treatment.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Master">
      <bpmn:lane id="Lane_Monitoring" name="Enquiry / Clinic Letter / Pathway Monitoring">
        <bpmn:flowNodeRef>Call_Communication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ReadyForFollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Master</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Funding / Payment / Refund">
        <bpmn:flowNodeRef>Call_Finance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Treatment" name="Treatment &#38; Chemotherapy">
        <bpmn:flowNodeRef>Call_Treatment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Appointment" name="Appointment &#38; Patient Communication">
        <bpmn:flowNodeRef>Call_Appointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ParallelSplit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Referral" name="Referral Administration &#38; Clinical Review">
        <bpmn:flowNodeRef>Start_Master</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Referral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ReferralAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ReferralClosed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Master" name="Patient Pathway Started">
      <bpmn:outgoing>F_001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="Call_Referral" name="Referral &#38; Consultant Review">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_Referral" propagateAllChildVariables="true" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_001</bpmn:incoming>
      <bpmn:outgoing>F_002</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="G_ReferralAccepted" name="Referral Accepted?" default="F_ReferralClosed">
      <bpmn:incoming>F_002</bpmn:incoming>
      <bpmn:outgoing>F_ReferralAccepted</bpmn:outgoing>
      <bpmn:outgoing>F_ReferralClosed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ReferralClosed" name="Referral Pathway Closed">
      <bpmn:incoming>F_ReferralClosed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_001" sourceRef="Start_Master" targetRef="Call_Referral" />
    <bpmn:sequenceFlow id="F_002" sourceRef="Call_Referral" targetRef="G_ReferralAccepted" />
    <bpmn:sequenceFlow id="F_ReferralAccepted" name="Accepted" sourceRef="G_ReferralAccepted" targetRef="Call_Appointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(referralDecision, "") = "ACCEPT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ReferralClosed" name="Not accepted" sourceRef="G_ReferralAccepted" targetRef="End_ReferralClosed" />
    <bpmn:sequenceFlow id="F_004" sourceRef="Call_Appointment" targetRef="G_ParallelSplit" />
    <bpmn:sequenceFlow id="F_006" name="Financial pathway" sourceRef="G_ParallelSplit" targetRef="Call_Finance" />
    <bpmn:sequenceFlow id="F_008" sourceRef="Call_Finance" targetRef="G_ParallelJoin" />
    <bpmn:sequenceFlow id="F_007" name="Financially cleared" sourceRef="G_ParallelJoin" targetRef="Call_Treatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= get or else(fundingType, "") = "HOSPITAL" or get or else(fundingType, "") = "EXEMPTION" or (get or else(fundingType, "") = "INSURER" and get or else(fundingApproved, false) = true) or (get or else(fundingType, "") = "PATIENT" and (get or else(paymentStatus, "") = "SUCCESSFUL" or get or else(urgentTreatmentOverride, false) = true))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_009" sourceRef="Call_Treatment" targetRef="G_ReadyForFollowUp" />
    <bpmn:sequenceFlow id="F_Ready" name="Start Clinic Letter" sourceRef="G_ReadyForFollowUp" targetRef="Call_Communication" />
    <bpmn:sequenceFlow id="F_NotReady" name="Financial clearance pending" sourceRef="G_ParallelJoin" targetRef="End_Pending" />
    <bpmn:sequenceFlow id="F_011" sourceRef="Call_Communication" targetRef="End_Master" />
    <bpmn:callActivity id="Call_Communication" name="Enquiry / Clinic Letter / Pathway Monitoring">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_EnquiryLetter" propagateAllChildVariables="true" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Ready</bpmn:incoming>
      <bpmn:outgoing>F_011</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Appointment" name="Appointment &#38; Patient Communication">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_Appointment" propagateAllChildVariables="true" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ReferralAccepted</bpmn:incoming>
      <bpmn:outgoing>F_004</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="G_ParallelSplit" name="Start Funding and Payment Clearance">
      <bpmn:incoming>F_004</bpmn:incoming>
      <bpmn:outgoing>F_006</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Call_Finance" name="Funding / Payment / Refund">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_Finance" propagateAllChildVariables="true" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_006</bpmn:incoming>
      <bpmn:outgoing>F_008</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="End_Pending" name="Pathway Closed / Pending Follow-up">
      <bpmn:incoming>F_NotReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_ParallelJoin" name="Financial Clearance for Treatment?" default="F_NotReady">
      <bpmn:incoming>F_008</bpmn:incoming>
      <bpmn:outgoing>F_007</bpmn:outgoing>
      <bpmn:outgoing>F_NotReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Call_Treatment" name="Treatment &#38; Chemotherapy">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_Treatment" propagateAllChildVariables="true" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_007</bpmn:incoming>
      <bpmn:outgoing>F_009</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="G_ReadyForFollowUp" name="Proceed to Clinic Letter">
      <bpmn:incoming>F_009</bpmn:incoming>
      <bpmn:outgoing>F_Ready</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Master" name="Patient Pathway Completed">
      <bpmn:incoming>F_011</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Master">
    <bpmn:participant id="Participant_Hospital" name="Hospital Patient Referral, Treatment and Administration System" processRef="Process_Hospital_Master" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Master">
    <bpmndi:BPMNPlane id="BPMNPlane_Master" bpmnElement="Collaboration_Master">
      <bpmndi:BPMNShape id="Participant_Hospital_di" bpmnElement="Participant_Hospital" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1260" height="830" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Referral_di" bpmnElement="Lane_Referral" isHorizontal="true">
        <dc:Bounds x="180" y="80" width="1230" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Appointment_di" bpmnElement="Lane_Appointment" isHorizontal="true">
        <dc:Bounds x="180" y="220" width="1230" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Treatment_di" bpmnElement="Lane_Treatment" isHorizontal="true">
        <dc:Bounds x="180" y="360" width="1230" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Finance_di" bpmnElement="Lane_Finance" isHorizontal="true">
        <dc:Bounds x="180" y="500" width="1230" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Monitoring_di" bpmnElement="Lane_Monitoring" isHorizontal="true">
        <dc:Bounds x="180" y="640" width="1230" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Master_di" bpmnElement="Start_Master">
        <dc:Bounds x="225" y="130" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="230" y="106" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Referral_di" bpmnElement="Call_Referral">
        <dc:Bounds x="320" y="108" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_ReferralAccepted_di" bpmnElement="G_ReferralAccepted" isMarkerVisible="true">
        <dc:Bounds x="595" y="123" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="594" y="85.5" width="52" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ReferralClosed_di" bpmnElement="End_ReferralClosed">
        <dc:Bounds x="962" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="938" y="158" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Communication_di" bpmnElement="Call_Communication">
        <dc:Bounds x="1090" y="780" width="300" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Appointment_di" bpmnElement="Call_Appointment">
        <dc:Bounds x="312" y="248" width="235" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_ParallelSplit_di" bpmnElement="G_ParallelSplit" isMarkerVisible="true">
        <dc:Bounds x="665" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="726" y="270" width="67" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Finance_di" bpmnElement="Call_Finance">
        <dc:Bounds x="580" y="520" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Pending_di" bpmnElement="End_Pending">
        <dc:Bounds x="382" y="702" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="357" y="738" width="86" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_ParallelJoin_di" bpmnElement="G_ParallelJoin" isMarkerVisible="true">
        <dc:Bounds x="665" y="695" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="656" y="755" width="67" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Treatment_di" bpmnElement="Call_Treatment">
        <dc:Bounds x="830" y="388" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_ReadyForFollowUp_di" bpmnElement="G_ReadyForFollowUp" isMarkerVisible="true">
        <dc:Bounds x="955" y="795" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="938" y="855" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Master_di" bpmnElement="End_Master">
        <dc:Bounds x="1172" y="690" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1150" y="652.5" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_001_di" bpmnElement="F_001">
        <di:waypoint x="261" y="148" />
        <di:waypoint x="320" y="148" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_002_di" bpmnElement="F_002">
        <di:waypoint x="540" y="148" />
        <di:waypoint x="595" y="148" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ReferralAccepted_di" bpmnElement="F_ReferralAccepted">
        <di:waypoint x="620" y="173" />
        <di:waypoint x="620" y="260" />
        <di:waypoint x="547" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="577" y="233" width="46" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ReferralClosed_di" bpmnElement="F_ReferralClosed">
        <di:waypoint x="645" y="148" />
        <di:waypoint x="964" y="148" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="773" y="123" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_004_di" bpmnElement="F_004">
        <di:waypoint x="547" y="300" />
        <di:waypoint x="665" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_006_di" bpmnElement="F_006">
        <di:waypoint x="690" y="325" />
        <di:waypoint x="690" y="520" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="661" y="413" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_008_di" bpmnElement="F_008">
        <di:waypoint x="690" y="600" />
        <di:waypoint x="690" y="695" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_007_di" bpmnElement="F_007">
        <di:waypoint x="715" y="720" />
        <di:waypoint x="940" y="720" />
        <di:waypoint x="940" y="468" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="802" y="695" width="52" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_009_di" bpmnElement="F_009">
        <di:waypoint x="980" y="468" />
        <di:waypoint x="980" y="795" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Ready_di" bpmnElement="F_Ready">
        <di:waypoint x="1005" y="820" />
        <di:waypoint x="1090" y="820" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1005" y="796" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_NotReady_di" bpmnElement="F_NotReady">
        <di:waypoint x="665" y="720" />
        <di:waypoint x="418" y="720" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="485" y="688" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_011_di" bpmnElement="F_011">
        <di:waypoint x="1190" y="780" />
        <di:waypoint x="1190" y="726" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
