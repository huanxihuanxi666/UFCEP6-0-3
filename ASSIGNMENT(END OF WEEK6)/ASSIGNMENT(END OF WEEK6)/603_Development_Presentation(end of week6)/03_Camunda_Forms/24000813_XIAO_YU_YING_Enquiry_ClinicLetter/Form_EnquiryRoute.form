{
  "components": [
    {
      "label": "Patient ID",
      "type": "textfield",
      "id": "Field_patientId",
      "key": "patientId",
      "validate": {
        "required": true,
        "minLength": 3,
        "maxLength": 64
      }
    },
    {
      "label": "Route / escalation action",
      "type": "select",
      "id": "Field_enquiryRouteAction",
      "key": "enquiryRouteAction",
      "values": [
        {
          "label": "Administrative response",
          "value": "ADMINISTRATIVE"
        },
        {
          "label": "Financial response",
          "value": "FINANCIAL"
        },
        {
          "label": "Clinical response",
          "value": "CLINICAL"
        },
        {
          "label": "Urgent clinical escalation",
          "value": "URGENT"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Response or escalation notes",
      "type": "textarea",
      "id": "Field_enquiryRouteNotes",
      "key": "enquiryRouteNotes",
      "validate": {
        "required": true,
        "minLength": 5,
        "maxLength": 1000
      }
    }
  ],
  "type": "default",
  "id": "Form_EnquiryRoute",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19
}
