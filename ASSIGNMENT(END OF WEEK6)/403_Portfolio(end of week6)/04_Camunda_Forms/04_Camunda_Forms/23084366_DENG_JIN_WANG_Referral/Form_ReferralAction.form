{
  "components": [
    {
      "label": "Patient ID",
      "type": "textfield",
      "id": "Field_patientId",
      "key": "patientId",
      "validate": {
        "required": true,
        "minLength": 3,
        "maxLength": 64
      }
    },
    {
      "label": "Referral action",
      "type": "select",
      "id": "Field_referralAction",
      "key": "referralAction",
      "values": [
        {
          "label": "Request missing information",
          "value": "REQUEST_MISSING"
        },
        {
          "label": "Request further clinical information",
          "value": "REQUEST_CLINICAL"
        },
        {
          "label": "Record rejection",
          "value": "REJECT"
        },
        {
          "label": "Record acceptance",
          "value": "ACCEPT"
        },
        {
          "label": "Record redirect",
          "value": "REDIRECT"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Reason / information requested",
      "type": "textarea",
      "id": "Field_referralActionReason",
      "key": "referralActionReason",
      "validate": {
        "required": true,
        "minLength": 5,
        "maxLength": 1000
      }
    },
    {
      "label": "Target service (required for redirect)",
      "type": "textfield",
      "id": "Field_targetService",
      "key": "targetService",
      "validate": {
        "required": false,
        "maxLength": 120
      }
    }
  ],
  "type": "default",
  "id": "Form_ReferralAction",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19
}
