{
  "components": [
    {
      "label": "Patient ID",
      "type": "textfield",
      "id": "Field_po_patient",
      "key": "patientId",
      "validate": {
        "required": true,
        "minLength": 3,
        "maxLength": 64
      }
    },
    {
      "label": "Transaction reference",
      "type": "textfield",
      "id": "Field_po_reference",
      "key": "transactionReference",
      "validate": {
        "required": true,
        "minLength": 3,
        "maxLength": 120
      }
    },
    {
      "label": "Payment status",
      "type": "select",
      "id": "Field_po_status",
      "key": "paymentStatus",
      "values": [
        {
          "label": "Successful",
          "value": "SUCCESSFUL"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Recorded by",
      "type": "textfield",
      "id": "Field_po_recorder",
      "key": "paymentOutcomeRecordedBy",
      "validate": {
        "required": true,
        "minLength": 3,
        "maxLength": 120
      }
    }
  ],
  "type": "default",
  "id": "Form_PaymentOutcome",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
