<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_PostmanMockPatient" targetNamespace="http://hospital.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="Process_PostmanMockPatientAPI" name="Postman Mock API and Referral Initiation" isExecutable="true">
    <bpmn:documentation>Standalone external-integration wrapper. It retrieves fictional patient data from Postman, validates and confirms that data, then calls the existing Process_Referral child process. It does not alter the existing Hospital Master Process or any original child BPMN.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_RetrievePatient" name="Start external patient retrieval">
      <bpmn:outgoing>Flow_Start_To_Retrieve</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_RetrievePatientDetails" name="Retrieve Patient Details">
      <bpmn:documentation>REST Connector. Replace YOUR-MOCK-ID with the mock-server ID generated by the imported Postman collection. It calls GET /patients/next and maps JSON fields to BPMN variables.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="http://localhost:4500/patients/next" target="url" />
          <zeebe:input source="={}" target="headers" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={patientId: body.patientId, patientName: body.patientName, referralType: body.referralType, referralStatus: body.referralStatus}" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_Retrieve</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_To_Retrieve</bpmn:incoming>
      <bpmn:outgoing>Flow_Retrieve_To_DataCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RequiredDataReceived" name="Required patient data received?" default="Flow_Data_Missing">
      <bpmn:incoming>Flow_Retrieve_To_DataCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_Data_Received</bpmn:outgoing>
      <bpmn:outgoing>Flow_Data_Missing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReviewImportedData" name="Review Imported Patient Data">
      <bpmn:documentation>Shows API variables to a user and requires confirmation before starting the existing referral process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_APIDataReview" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Data_Received</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_To_Confirmation</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DataConfirmed" name="Imported data confirmed?" default="Flow_Data_NotConfirmed">
      <bpmn:incoming>Flow_Review_To_Confirmation</bpmn:incoming>
      <bpmn:outgoing>Flow_Data_Confirmed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Data_NotConfirmed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="CallActivity_ReferralWorkflow" name="Start Referral and Consultant Review">
      <bpmn:documentation>Calls the existing Referral and Consultant Review child process. The called process ID matches the existing integrated master process: Process_Referral.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_Referral" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Data_Confirmed</bpmn:incoming>
      <bpmn:outgoing>Flow_Referral_To_End</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="Task_ResolveExternalData" name="Resolve Missing External Data">
      <bpmn:documentation>Records why the API result cannot be used and whether the user wants to retry the external request. It is used when required fields are missing or when the imported data is not confirmed.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_ResolveExternalData" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Data_NotConfirmed</bpmn:incoming>
      <bpmn:incoming>Flow_Data_Missing</bpmn:incoming>
      <bpmn:outgoing>Flow_Resolve_To_Retry</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RetryExternalAPI" name="Retry external API?" default="Flow_No_Retry">
      <bpmn:incoming>Flow_Resolve_To_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_To_Retrieve</bpmn:outgoing>
      <bpmn:outgoing>Flow_No_Retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_ReferralComplete" name="Referral workflow complete">
      <bpmn:incoming>Flow_Referral_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_ExternalDataUnresolved" name="External data unresolved">
      <bpmn:incoming>Flow_No_Retry</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_To_Retrieve" sourceRef="StartEvent_RetrievePatient" targetRef="Task_RetrievePatientDetails" />
    <bpmn:sequenceFlow id="Flow_Retrieve_To_DataCheck" sourceRef="Task_RetrievePatientDetails" targetRef="Gateway_RequiredDataReceived" />
    <bpmn:sequenceFlow id="Flow_Data_Received" name="Yes" sourceRef="Gateway_RequiredDataReceived" targetRef="Task_ReviewImportedData">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=patientId != null and patientId != "" and referralType != null and referralType != ""</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Review_To_Confirmation" sourceRef="Task_ReviewImportedData" targetRef="Gateway_DataConfirmed" />
    <bpmn:sequenceFlow id="Flow_Data_Confirmed" name="Yes" sourceRef="Gateway_DataConfirmed" targetRef="CallActivity_ReferralWorkflow">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=dataConfirmed = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Data_NotConfirmed" name="No" sourceRef="Gateway_DataConfirmed" targetRef="Task_ResolveExternalData" />
    <bpmn:sequenceFlow id="Flow_Resolve_To_Retry" sourceRef="Task_ResolveExternalData" targetRef="Gateway_RetryExternalAPI" />
    <bpmn:sequenceFlow id="Flow_Retry_To_Retrieve" name="Yes" sourceRef="Gateway_RetryExternalAPI" targetRef="Task_RetrievePatientDetails">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryExternalApi = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_No_Retry" name="No" sourceRef="Gateway_RetryExternalAPI" targetRef="EndEvent_ExternalDataUnresolved" />
    <bpmn:sequenceFlow id="Flow_Referral_To_End" sourceRef="CallActivity_ReferralWorkflow" targetRef="EndEvent_ReferralComplete" />
    <bpmn:sequenceFlow id="Flow_Data_Missing" name="No" sourceRef="Gateway_RequiredDataReceived" targetRef="Task_ResolveExternalData" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PostmanMockPatient">
    <bpmndi:BPMNPlane id="BPMNPlane_PostmanMockPatient" bpmnElement="Process_PostmanMockPatientAPI">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_RetrievePatient">
        <dc:Bounds x="180" y="240" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="147" y="282" width="102" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Retrieve" bpmnElement="Task_RetrievePatientDetails">
        <dc:Bounds x="280" y="218" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DataCheck" bpmnElement="Gateway_RequiredDataReceived" isMarkerVisible="true">
        <dc:Bounds x="530" y="233" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="502" y="293" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Review" bpmnElement="Task_ReviewImportedData">
        <dc:Bounds x="465" y="80" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Confirmed" bpmnElement="Gateway_DataConfirmed" isMarkerVisible="true">
        <dc:Bounds x="810" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="772" y="71" width="126" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CallReferral" bpmnElement="CallActivity_ReferralWorkflow">
        <dc:Bounds x="1060" y="80" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Resolve" bpmnElement="Task_ResolveExternalData">
        <dc:Bounds x="745" y="218" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Retry" bpmnElement="Gateway_RetryExternalAPI" isMarkerVisible="true">
        <dc:Bounds x="810" y="395" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="787" y="455" width="96" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndReferral" bpmnElement="EndEvent_ReferralComplete">
        <dc:Bounds x="1137" y="240" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1091" y="284" width="133" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndUnresolved" bpmnElement="EndEvent_ExternalDataUnresolved">
        <dc:Bounds x="992" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="949" y="378" width="122" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Start_Retrieve" bpmnElement="Flow_Start_To_Retrieve">
        <di:waypoint x="216" y="258" />
        <di:waypoint x="280" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Retrieve_DataCheck" bpmnElement="Flow_Retrieve_To_DataCheck">
        <di:waypoint x="450" y="258" />
        <di:waypoint x="530" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Data_Received" bpmnElement="Flow_Data_Received">
        <di:waypoint x="555" y="233" />
        <di:waypoint x="555" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="561" y="188" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Data_Missing" bpmnElement="Flow_Data_Missing">
        <di:waypoint x="580" y="258" />
        <di:waypoint x="745" y="258" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="650" y="235" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Review_Confirm" bpmnElement="Flow_Review_To_Confirmation">
        <di:waypoint x="645" y="120" />
        <di:waypoint x="810" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Data_Confirmed" bpmnElement="Flow_Data_Confirmed">
        <di:waypoint x="860" y="120" />
        <di:waypoint x="1060" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="954" y="95" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Data_NotConfirmed" bpmnElement="Flow_Data_NotConfirmed">
        <di:waypoint x="835" y="145" />
        <di:waypoint x="835" y="218" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="842" y="188" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Resolve_Retry" bpmnElement="Flow_Resolve_To_Retry">
        <di:waypoint x="835" y="298" />
        <di:waypoint x="835" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Retry_Retrieve" bpmnElement="Flow_Retry_To_Retrieve">
        <di:waypoint x="810" y="420" />
        <di:waypoint x="365" y="420" />
        <di:waypoint x="365" y="298" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="579" y="395" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_No_Retry" bpmnElement="Flow_No_Retry">
        <di:waypoint x="860" y="420" />
        <di:waypoint x="992" y="420" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="917" y="395" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Referral_End" bpmnElement="Flow_Referral_To_End">
        <di:waypoint x="1155" y="160" />
        <di:waypoint x="1155" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
