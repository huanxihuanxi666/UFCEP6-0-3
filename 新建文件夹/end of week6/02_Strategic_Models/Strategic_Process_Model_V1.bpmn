<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Strategic_V1" targetNamespace="http://hospital.example/strategy" exporter="Camunda Modeler" exporterVersion="5.41.0">
  <bpmn:process id="Strategic_Process_V1" name="Release 1 Strategic Hospital Pathway" isExecutable="false">
    <bpmn:documentation>High-level representation of what the current Release 1 supports. It is not a target-state or case-study wish list.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Strategic">
      <bpmn:lane id="Lane_Patient" name="Patient and referrer" />
      <bpmn:lane id="Lane_Hospital" name="Hospital operational system" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Referral received">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Referral" name="Capture and validate referral">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Review" name="Consultant review and decision">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Accepted" name="Referral accepted?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>FClosed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndClosed" name="Referral closed">
      <bpmn:incoming>FClosed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Appointment" name="Book appointment and communicate">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Finance" name="Determine funding and process payment">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Clear" name="Financially cleared?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>FClosed2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Treatment" name="Request and review treatment">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Letter" name="Prepare approve and distribute clinic letter">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="EndComplete" name="Supported pathway complete">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Referral" />
    <bpmn:sequenceFlow id="F2" sourceRef="Referral" targetRef="Review" />
    <bpmn:sequenceFlow id="F3" sourceRef="Review" targetRef="Accepted" />
    <bpmn:sequenceFlow id="F4" name="Yes" sourceRef="Accepted" targetRef="Appointment" />
    <bpmn:sequenceFlow id="FClosed" name="No" sourceRef="Accepted" targetRef="EndClosed" />
    <bpmn:sequenceFlow id="F5" sourceRef="Appointment" targetRef="Finance" />
    <bpmn:sequenceFlow id="F6" sourceRef="Finance" targetRef="Clear" />
    <bpmn:sequenceFlow id="F7" name="Yes" sourceRef="Clear" targetRef="Treatment" />
    <bpmn:sequenceFlow id="FClosed2" name="Pending" sourceRef="Clear" targetRef="EndClosed" />
    <bpmn:sequenceFlow id="F8" sourceRef="Treatment" targetRef="Letter" />
    <bpmn:sequenceFlow id="F9" sourceRef="Letter" targetRef="EndComplete" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Strategic">
    <bpmndi:BPMNPlane id="Plane_Strategic" bpmnElement="Strategic_Process_V1">
      <bpmndi:BPMNShape id="EndClosed_di" bpmnElement="EndClosed">
        <dc:Bounds x="1257" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1237" y="368" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Accepted_di" bpmnElement="Accepted" isMarkerVisible="true">
        <dc:Bounds x="725" y="113" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="724" y="75.5" width="52" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Clear_di" bpmnElement="Clear" isMarkerVisible="true">
        <dc:Bounds x="1250" y="113" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1248" y="75.5" width="53" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndComplete_di" bpmnElement="EndComplete">
