        <di:waypoint x="1785" y="790" />
        <di:waypoint x="600" y="790" />
        <di:waypoint x="600" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_002" bpmnElement="Flow_002">
        <di:waypoint x="510" y="450" />
        <di:waypoint x="580" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_005" bpmnElement="Flow_005">
        <di:waypoint x="840" y="445" />
