{
  "components": [
    {
      "label": "Patient ID",
      "type": "textfield",
      "id": "Field_approvalPatientId",
      "key": "patientId",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Clinical content approved by authorised clinician",
      "type": "checkbox",
      "id": "Field_clinicLetterApproved",
      "key": "clinicLetterApproved",
      "defaultValue": true
    },
    {
      "label": "Still within 7 days of the consultation",
      "type": "checkbox",
      "id": "Field_clinicLetterWithin7Days",
      "key": "clinicLetterWithin7Days",
      "defaultValue": true
    },
    {
      "label": "Clinical correction note",
      "type": "textarea",
      "id": "Field_clinicLetterCorrectionNote",
      "key": "clinicLetterCorrectionNote",
      "validate": {
        "required": false
      }
    }
  ],
  "type": "default",
  "id": "Form_ClinicLetterApproval",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19
}