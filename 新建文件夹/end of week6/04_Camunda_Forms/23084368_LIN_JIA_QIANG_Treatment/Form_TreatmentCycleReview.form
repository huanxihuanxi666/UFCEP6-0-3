{
  "components": [
    {
      "label": "Patient ID",
      "type": "textfield",
      "id": "Field_cycle_patientId",
      "key": "patientId",
      "validate": {
        "required": true
      }
    },
    {
      "label": "More treatment cycles required",
      "type": "checkbox",
      "id": "Field_moreCycles",
      "key": "moreCycles",
      "defaultValue": false
    },
    {
      "label": "Clinical decision",
      "values": [
        {
          "label": "Continue",
          "value": "CONTINUE"
        },
        {
          "label": "Delay",
          "value": "DELAY"
        },
        {
          "label": "Modify",
          "value": "MODIFY"
        }
      ],
      "type": "select",
      "id": "Field_clinicalDecision",
      "key": "clinicalDecision",
      "validate": {
        "required": true
      },
      "defaultValue": "CONTINUE"
    },
    {
      "label": "Modification has financial impact",
      "type": "checkbox",
      "id": "Field_financialImpact",
      "key": "financialImpact",
      "defaultValue": false
    }
  ],
  "type": "default",
  "id": "Form_TreatmentCycleReview",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19
